{
  "name": "apia",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for APIA — AI-native API manifests standard",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["apia", "api", "ai", "agents", "llm", "manifests"],
  "author": "APIA Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Komsomol39/apia-js"
  },
  "homepage": "https://github.com/Komsomol39/apia-standard",
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"]
  }
}
